{
  "name": "steampunk-platformer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "node tools/gen/build-assets.mjs",
    "assets:clips": "node tools/gen/build-clips.mjs",
    "assets:prompts": "node tools/gen/write-prompts.mjs",
    "assets:world": "node tools/gen/build-world.mjs",
    "build": "tsc --noEmit && vite build && node tools/gen/verify-dist.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sim-isolated": "npm rm phaser && vitest run && npm i phaser@4.2.1 --save-exact",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
